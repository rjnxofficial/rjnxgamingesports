# =====================================================================
# RJNX GAMING ESPORTS — environment template
# Copy to apps/web/.env.local (website) and apps/mobile/.env (Android app)
# Never commit real secrets. The service role key is SERVER-SIDE ONLY.
# =====================================================================

# ---------------------------------------------------------------- Supabase
# Project URL (safe for clients)
NEXT_PUBLIC_SUPABASE_URL=https://nuckewrlcjphjmnfgilo.supabase.co
# Publishable / anon key (safe for clients, protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bj2iYWHvILa6__h5bZrsmA_F2CPG1gj

# ---------- SERVER ONLY (never expose with NEXT_PUBLIC_) ----------
# Supabase service role key — required for audit fan-out, admin stats and
# payment verification. Leave empty to run without privileged fallbacks.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string used by `npm run db:push`
# Format: postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=

# ------------------------------------------------------------------- app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_SCHEME=rjnx

# Optional: comma separated emails allowed to bootstrap the first super admin.
RJNX_BOOTSTRAP_ADMIN_EMAILS=

# ------------------------------------------- payments (optional module)
# The checkout button appears automatically once both keys below are set on the
# server. Razorpay keys stay server-side. Never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ----------------------------------------------------- mobile / Expo
# Same Supabase project as the website so both share users + data.
EXPO_PUBLIC_SUPABASE_URL=https://nuckewrlcjphjmnfgilo.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_bj2iYWHvILa6__h5bZrsmA_F2CPG1gj
EXPO_PUBLIC_SITE_URL=https://rjnxgamingesports.com
EXPO_PUBLIC_EAS_PROJECT_ID=
