{
  "expo": {
    "name": "RJNX GAMING ESPORTS",
    "slug": "rjnx-gaming-esports",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rjnx",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#05050A",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#05050A"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "com.devkazzu.rjnxgamingesports",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#05050A"
      },
      "permissions": ["INTERNET", "POST_NOTIFICATIONS", "VIBRATE"],
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devkazzu.rjnxgamingesports"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#00CFFF"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05050A",
          "image": "./assets/splash.png",
          "imageWidth": 220,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    }
  }
}
